# Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o Git (esta no .gitignore).

# --- Portal da OAB ---
OAB_USER=
OAB_PASS=

# --- Canais de envio ---
# Quais canais recebem as publicacoes e os avisos de falha.
# Valores: whatsapp | email | whatsapp,email
# So "whatsapp" dispensa a Senha de app do Google.
CANAIS=whatsapp,email

# --- E-mail (remetente) ---
# SMTP_PASS NAO e a senha normal do Gmail. E uma "Senha de app":
#   Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app
SMTP_USER=
SMTP_PASS=

# --- E-mail (destino) ---
# Aceita varios separados por virgula.
MAIL_TO=

# --- WhatsApp (destino) ---
# Formato internacional, so digitos: 55 + DDD + numero
WHATSAPP_TO=

# --- Portal da OAB como fonte (opcional) ---
# 1 = consulta tambem o portal, alem da API do CNJ. O portal e mais completo
# (traz os diarios de MG e da Uniao), mas exige uma janela de Chrome aberta e
# autenticada por voce: "npm run abrir-chrome". Sem isso, deixe desligado.
PORTAL=0
# Porta de depuracao onde essa janela escuta (o abrir-chrome usa a mesma).
CDP_ENDPOINT=http://127.0.0.1:9222

# --- Contagem de prazo (opcional) ---
# Feriados que a conta nao tem como saber: estaduais, municipais e forenses
# (Dia da Justica, aniversario da comarca, portaria de suspensao do tribunal).
# dd/mm/aaaa separados por virgula. Sem eles o vencimento estimado pode sair
# um dia adiantado (lado seguro). Ja uma data que NAO e feriado empurra o
# vencimento para FRENTE — o lado que faz perder prazo. Por isso: so entra aqui
# data conferida no calendario do TJSP da SUA comarca, e o vencimento que usar
# uma delas sai dizendo que usou.
FERIADOS_EXTRA=

# Feriado que vale em UMA comarca so (aniversario da cidade, padroeira).
# Formato: codigo:datas;codigo:datas — o codigo sao os 4 ultimos digitos do
# numero CNJ do processo (a unidade de origem).
# O aniversario de uma cidade nao e feriado na comarca vizinha: por isso ele NAO
# pode ir no FERIADOS_EXTRA, que vale para tudo.
# Exemplo: FERIADOS_COMARCA=0100:20/08/2026;0200:08/04/2026
FERIADOS_COMARCA=

# --- Variantes de sufixo da OAB (opcional) ---
# Os tribunais gravam a inscricao como 123456, 123456-O, 123456-A... e a busca
# do CNJ e por igualdade exata. 1 = varre as 6 variantes em toda execucao.
# Padrao (0): so a base, e as variantes so quando a base vem VAZIA — varrer
# sempre custa 6 consultas extras e arrisca HTTP 429, que derruba o dia todo.
VARIANTES_OAB=0

# --- Opcionais ---
# Fuso usado para decidir que dia e "hoje"
TZ_APP=America/Sao_Paulo
# Milissegundos de espera para cada acao do navegador
NAV_TIMEOUT_MS=45000

# --- Inscricao OAB (consulta a API do CNJ) ---
OAB_NUMERO=
OAB_UF=SP
