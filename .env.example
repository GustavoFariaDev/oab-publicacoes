# Copie este arquivo para .env e preencha.
# O .env NUNCA vai para o Git (esta no .gitignore).

# --- Portal da OAB ---
OAB_USER=
OAB_PASS=

# --- Canais de envio ---
# Quais canais recebem as publicacoes e os avisos de falha.
# Valores: whatsapp | email | whatsapp,email
# So "whatsapp" dispensa a Senha de app do Google.
CANAIS=whatsapp,email

# --- E-mail (remetente) ---
# SMTP_PASS NAO e a senha normal do Gmail. E uma "Senha de app":
#   Conta Google > Seguranca > Verificacao em duas etapas > Senhas de app
SMTP_USER=
SMTP_PASS=

# --- E-mail (destino) ---
# Aceita varios separados por virgula.
MAIL_TO=

# --- WhatsApp (destino) ---
# Formato internacional, so digitos: 55 + DDD + numero
WHATSAPP_TO=

# --- Portal da OAB como fonte (opcional) ---
# 1 = consulta tambem o portal, alem da API do CNJ. O portal e mais completo
# (traz os diarios de MG e da Uniao), mas exige uma janela de Chrome aberta e
# autenticada por voce: "npm run abrir-chrome". Sem isso, deixe desligado.
PORTAL=0
# Porta de depuracao onde essa janela escuta (o abrir-chrome usa a mesma).
CDP_ENDPOINT=http://127.0.0.1:9222

# --- Opcionais ---
# Fuso usado para decidir que dia e "hoje"
TZ_APP=America/Sao_Paulo
# Milissegundos de espera para cada acao do navegador
NAV_TIMEOUT_MS=45000

# --- Inscricao OAB (consulta a API do CNJ) ---
OAB_NUMERO=
OAB_UF=SP
