{
  "name": "oab-publicacoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consulta diária das publicações do Diário da Justiça pela inscrição da OAB e avisa por WhatsApp e e-mail, com PDF do inteiro teor e contagem de prazo em dias úteis",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "once": "node src/index.js",
    "dry": "node src/index.js --dry",
    "teste": "node teste/todos.mjs",
    "inspecionar": "node scripts/inspecionar.js",
    "setup:whatsapp": "node scripts/setup-whatsapp.js",
    "register-task": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-task.ps1",
    "abrir-chrome": "node scripts/abrir-chrome.js",
    "explorar": "node scripts/explorar.js"
  },
  "dependencies": {
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "playwright": "^1.49.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
